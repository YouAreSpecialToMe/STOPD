new file mode 100644
index 000000000..c6f71eb5a
--- /dev/null
+++ b/examples/configs/distillation_math_stopd.yaml
@@ -0,0 +1,31 @@
+# STOPD (https://github.com/YouAreSpecialToMe/STOPD) on top of the math distillation example.
+#   uv run examples/run_distillation.py --config examples/configs/distillation_math_stopd.yaml
+# STOPD needs: one optimizer step per rollout batch, single-turn rollouts, the synchronous vLLM engine,
+# and a context that holds the longest prompt plus max_new_tokens (the L of STOPD).
+defaults: distillation_math.yaml
+
+stopd:
+  block: 128                 # K; the largest weight is L / K
+  warmup_steps: 25           # initial Vanilla OPD steps
+  initial_denominator: null  # C of the first STOPD step when warmup_steps is 0
+  seed: 42
+
+distillation:
+  num_prompts_per_step: 128
+  num_generations_per_prompt: 1
+  max_rollout_turns: 1
+
+policy:
+  train_global_batch_size: 128     # = num_prompts_per_step * num_generations_per_prompt
+  max_total_sequence_length: 9216  # longest prompt (1024) + L (8192)
+  generation:
+    max_new_tokens: 8192           # L
+    vllm_cfg:
+      async_engine: false
+      max_model_len: 9216
+
+teacher:
+  max_total_sequence_length: 9216
+
+data:
+  max_input_seq_length: 1024
