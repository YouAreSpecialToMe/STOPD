diff --git a/nemo_rl/algorithms/stopd.py b/nemo_rl/algorithms/stopd.py
new file mode 100644
index 000000000..394e34287
--- /dev/null
+++ b/nemo_rl/algorithms/stopd.py
@@ -0,0 +1,140 @@
+# Copyright 2026 the STOPD authors. Licensed under the Apache License, Version 2.0.
+"""STOPD (Stochastic Truncated On-Policy Distillation) for on-policy distillation.
+
+https://github.com/YouAreSpecialToMe/STOPD
+
+Enabled by a top-level ``stopd`` block in the distillation config::
+
+    stopd:
+      block: 128                  # K; the largest weight is L / K
+      warmup_steps: 25            # initial Vanilla OPD steps
+      initial_denominator: null   # C of the first STOPD step when warmup_steps is 0
+      seed: 42
+
+L is ``policy.generation.max_new_tokens``. Before generation, every training
+rollout gets its own max_new_tokens: the end of a uniformly drawn token's block.
+The loss is NeMo-RL's own distillation loss, with each token multiplied by its
+inverse keep probability and the sum divided by C_k, which is fixed before step
+k (the last warmup step's token count, then the previous step's IPW-weighted
+token count), instead of the batch's valid-token count.
+
+The training driver keeps the schedule and needs the ``stopd`` package
+(``pip install git+https://github.com/YouAreSpecialToMe/STOPD``). The policy
+workers only unpickle the loss below, which depends on torch and nemo_rl alone.
+"""
+
+from typing import Any, Optional
+
+import torch
+
+from nemo_rl.algorithms.loss.loss_functions import DistillationLossFn
+
+
+def ipw_weights(token_mask: torch.Tensor, max_len: int, block: int) -> torch.Tensor:
+    """1 / p_t at the response tokens of a [B, S] mask (0 elsewhere), t counted from each response's start."""
+    mask = token_mask.bool()
+    pos = (mask.long().cumsum(-1) - 1).clamp_min(0)
+    weights = max_len / (max_len - (pos // block) * block).to(torch.float32)
+    return weights * mask
+
+
+class STOPDDistillationLossFn(DistillationLossFn):
+    """NeMo-RL's distillation loss with STOPD's weights and denominator, plus the driver-side schedule."""
+
+    def __init__(
+        self,
+        cfg: Any,
+        stopd_cfg: dict[str, Any],
+        master_config: Any,
+        loaded_state: Optional[dict[str, Any]] = None,
+    ):
+        super().__init__(cfg)
+        from stopd import STOPD  # driver only
+
+        generation = master_config.policy["generation"]
+        distillation = master_config.distillation
+        self.max_len = int(generation["max_new_tokens"])
+        self.block = int(stopd_cfg.get("block", 128))
+        rollouts = distillation.num_prompts_per_step * distillation.num_generations_per_prompt
+        if master_config.policy["train_global_batch_size"] != rollouts:
+            raise ValueError(
+                "STOPD needs one optimizer step per rollout batch: set policy.train_global_batch_size to "
+                f"num_prompts_per_step * num_generations_per_prompt = {rollouts}"
+            )
+        if distillation.max_rollout_turns != 1:
+            raise ValueError("STOPD supports single-turn rollouts only (distillation.max_rollout_turns: 1)")
+        vllm_cfg = generation.get("vllm_cfg") or {}
+        if vllm_cfg.get("async_engine"):
+            raise ValueError("STOPD needs policy.generation.vllm_cfg.async_engine: false")
+        max_prompt = int(master_config.data["max_input_seq_length"])
+        if int(vllm_cfg.get("max_model_len", max_prompt + self.max_len)) < max_prompt + self.max_len:
+            raise ValueError(
+                "vllm_cfg.max_model_len must hold the longest prompt (data.max_input_seq_length) plus "
+                "max_new_tokens; a rollout cut by the context is a truncation the weights do not model"
+            )
+        self.schedule = STOPD(
+            max_len=self.max_len,
+            block=self.block,
+            warmup_steps=int(stopd_cfg.get("warmup_steps", 0)),
+            initial_denominator=stopd_cfg.get("initial_denominator"),
+            seed=stopd_cfg.get("seed", distillation.seed),
+        )
+        if loaded_state and loaded_state.get("stopd"):
+            self.schedule.load_state_dict(loaded_state["stopd"])
+        self.denominator: Optional[float] = None  # C_k of the running step; None at Vanilla warmup steps
+
+    def __getstate__(self):
+        # The loss is sent to the policy workers on every train call; they need no schedule.
+        state = dict(self.__dict__)
+        state["schedule"] = None
+        return state
+
+    # ---------------------------------------------------------------- driver, once per step
+    def budgets(self, n: int) -> torch.Tensor:
+        """max_new_tokens of the step's n training rollouts (all L during the warmup)."""
+        return torch.tensor(self.schedule.budgets(n), dtype=torch.long)
+
+    def begin_step(self, total_steps: int) -> None:
+        if self.schedule.step != total_steps:
+            raise RuntimeError(
+                f"STOPD state is at step {self.schedule.step} but training at {total_steps}; "
+                "the checkpoint was not written with STOPD"
+            )
+        self.denominator = self.schedule.denominator if self.schedule.truncating else None
+
+    def end_step(self, train_data: Any) -> dict[str, float]:
+        mask = train_data["token_mask"] * train_data["sample_mask"].unsqueeze(-1)
+        stats = self.schedule.end_step(mask, reduce=None)  # the driver holds the whole batch
+        return {
+            f"stopd/{k}": float(v)
+            for k, v in stats.items()
+            if isinstance(v, (int, float)) and not isinstance(v, bool) and k != "step"
+        }
+
+    def state_dict(self) -> dict[str, Any]:
+        return self.schedule.state_dict()
+
+    # ---------------------------------------------------------------- workers
+    def __call__(
+        self,
+        student_topk_logprobs: torch.Tensor,
+        teacher_topk_logprobs: torch.Tensor,
+        H_all: torch.Tensor | None,
+        data: Any,
+        global_valid_seqs: torch.Tensor,
+        global_valid_toks: torch.Tensor,
+    ) -> tuple[torch.Tensor, dict[str, Any]]:
+        if self.denominator is None:
+            return super().__call__(
+                student_topk_logprobs, teacher_topk_logprobs, H_all, data, global_valid_seqs, global_valid_toks
+            )
+        # The parent multiplies its per-token KL by token_mask and divides the sum by global_valid_toks.
+        token_mask = data["token_mask"]
+        weighted = dict(data)
+        weighted["token_mask"] = token_mask * ipw_weights(token_mask, self.max_len, self.block).to(
+            token_mask.device
+        )
+        denominator = torch.tensor(self.denominator, dtype=torch.float32, device=token_mask.device)
+        return super().__call__(
+            student_topk_logprobs, teacher_topk_logprobs, H_all, weighted, global_valid_seqs, denominator
+        )
